# Frontend public configuration.
# Anything starting with VITE_ is visible in the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_N8N_BASE_URL=
VITE_ELEVENLABS_AGENT_ID=

# Server / n8n-only secrets.
# Never put these in VITE_ variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
ELEVENLABS_API_KEY=
N8N_WEBHOOK_SECRET=